<quiqqer>
    <package>

        <title>
            <locale group="quiqqer/shipping" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/shipping" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="commerce.shipping-methods">
                <title>Shipping methods</title>
                <description>
                    Manages shipping methods, checkout selection, delivery details and configurable eligibility and pricing rules.
                </description>
            </capability>

            <capability id="fulfillment.shipping-statuses">
                <title>Shipping statuses</title>
                <description>
                    Manages configurable shipping statuses and optional customer notifications for status changes.
                </description>
            </capability>

            <capability id="fulfillment.shipment-tracking">
                <title>Shipment tracking</title>
                <description>
                    Records carrier tracking details and provides country-specific links to external tracking services.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/Logo.png"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/en/shipping-order.png"/>
            <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/en/shipping-panel.png"/>
            <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/en/shipping-panel-ups.png"/>
            <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/en/shipping-rule.png"/>
            <image src="URL_OPT_DIR/quiqqer/shipping/bin/images/en/shipping-rule-settings.png"/>
        </preview>

        <provider>
            <shipping src="\QUI\ERP\Shipping\Provider"/>
            <orderProcess src="\QUI\ERP\Shipping\OrderProcessProvider"/>
        </provider>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/shipping]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/shipping/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/shipping/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0+]]></license>
            <license><![CDATA[PCSG QEL-1.0]]></license>
        </copyright>
    </package>
</quiqqer>
